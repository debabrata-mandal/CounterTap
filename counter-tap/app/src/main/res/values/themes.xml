<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CounterTap" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#101827</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <!-- Splash screen theme — applied to the activity, transitions to Theme.CounterTap -->
    <style name="Theme.CounterTap.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#101827</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CounterTap</item>
    </style>
</resources>
